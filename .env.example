# Copy to .env and set values for your environment. Never commit real credentials.
APP_ENV=development

# Comma-separated, trusted bootstrap administrators. Never accept this from a web request.
BANKEASE_ADMIN_EMAILS=

# Development default. Local JSON auth and owner-scoped document records.
BANKEASE_STORAGE_BACKEND=local-json
BANKEASE_DATA=data/runtime
BANKEASE_RETENTION_HOURS=24
BANKEASE_RETENTION_SWEEP_SECONDS=900
BANKEASE_ASYNC_DOCUMENTS=true
BANKEASE_ENABLE_DOCUMENT_WORKER=true
BANKEASE_JOB_MAX_ATTEMPTS=3
BANKEASE_JOB_LEASE_SECONDS=180
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100
BANKEASE_OCR_LANGUAGE=eng
BANKEASE_OCR_DPI=150
BANKEASE_OCR_MAX_PAGES=10
BANKEASE_OCR_PAGE_TIMEOUT_SECONDS=15
BANKEASE_OCR_DOCUMENT_TIMEOUT_SECONDS=45
PORT=8000
BANKEASE_API_ORIGIN=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8000

# To exercise the MongoDB repository locally, use a local mongod or Atlas URI.
# When BANKEASE_STORAGE_BACKEND=mongodb, MONGODB_URI is required.
MONGODB_URI=
MONGODB_DATABASE=bankease
MONGODB_CONNECT_TIMEOUT_MS=5000

# AI inference is local-first. Ollama must be installed and the model pulled separately.
# The application never pulls a model automatically.
AI_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Primary model for general/chat use. Keep the main model under ~1.5 GB when you want
# lightweight local inference and fast fallback switching.
OLLAMA_MODEL=qwen3:1.7b
# Optional smaller fallback models. If the active model times out or hits its response limit,
# BankEase will retry the next model in this comma-separated list.
OLLAMA_FALLBACK_MODELS=qwen3:0.6b,llama3.2:1b-instruct
OLLAMA_NUM_CTX=4096
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=512
AI_RETRIEVAL_MIN_COVER=0.5
AI_RETRIEVAL_MIN_SCORE=0.8

# Optional Hugging Face Inference Providers adapter. Disabled by default.
# It may require purchased credits; it is not part of the ₹0 local workflow.
HOSTED_AI_ENABLED=false
HOSTED_AI_PROVIDER=huggingface
HOSTED_AI_MODEL=
HOSTED_AI_API_KEY=

# Optional self-hosted SearXNG endpoint. Web research remains off until configured and selected.
SEARXNG_BASE_URL=

# Optional path to a JSON model registry; defaults to config/ai_models.json.
BANKEASE_MODEL_REGISTRY=
